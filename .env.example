# ─── PeaLuna — copy to .env (root) and apps/*/.env.local ───

NODE_ENV=development

# EU-primary region (multi-region ready via homeRegion on users/orders)
DEPLOYMENT_REGION=eu-central-1
AWS_REGION=eu-central-1

# API
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://velure:velure_dev@localhost:5432/velure?schema=public
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long

CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SECRET=change-me-cookie-secret-min-32-characters-long
COOKIE_DOMAIN=

# Email — SMTP required in production. Empty = log verification links in development.
SMTP_URL=
EMAIL_FROM=PeaLuna <noreply@localhost>
SENTRY_DSN=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# S3-compatible (MinIO local / AWS S3 eu-central-1 in prod)
S3_BUCKET=velure-media
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=velure
S3_SECRET_KEY=velure_dev_secret

# Stripe (Israel / EU Connect) — required in production. Empty = escrow simulation in development only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
WEB_ORIGIN=http://localhost:3000

# Railway private preview — skip Stripe / S3 / SMTP boot checks (never on pealuna.com)
# PREVIEW_MODE=true

# Web
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
API_URL=http://localhost:4000

# Staging / Railway private preview — never enable on the public production domain
# PREVIEW_MODE=true
# NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
# ALLOW_DEMO_SEED=true
