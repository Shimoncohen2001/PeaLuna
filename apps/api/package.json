{
  "name": "@velure/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@velure/auth": "workspace:*",
    "@velure/contracts": "workspace:*",
    "@velure/database": "workspace:*",
    "@velure/domain": "workspace:*",
    "@velure/logger": "workspace:*",
    "fastify": "^5.3.3",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.6.1",
    "nodemailer": "^7.0.6",
    "stripe": "^22.6.1",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^22.15.29",
    "@velure/config-eslint": "workspace:*",
    "@velure/config-typescript": "workspace:*",
    "eslint": "^9.28.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
