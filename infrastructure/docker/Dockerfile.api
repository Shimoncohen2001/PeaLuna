# syntax=docker/dockerfile:1

FROM node:20.11-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/auth/package.json ./packages/auth/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/database/package.json ./packages/database/
COPY packages/domain/package.json ./packages/domain/
COPY packages/logger/package.json ./packages/logger/
COPY packages/config-eslint/package.json ./packages/config-eslint/
COPY packages/config-typescript/package.json ./packages/config-typescript/
RUN pnpm install --frozen-lockfile --filter @velure/api...

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
COPY . .
RUN pnpm --filter @velure/api... build

FROM node:20.11-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
RUN apk add --no-cache wget openssl libc6-compat su-exec
RUN addgroup -g 1001 -S nodejs && adduser -S pealuna -u 1001 -G nodejs

COPY --from=builder --chown=pealuna:nodejs /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=builder --chown=pealuna:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=pealuna:nodejs /app/packages ./packages
COPY --from=builder --chown=pealuna:nodejs /app/apps/api ./apps/api
COPY --from=builder --chown=pealuna:nodejs /app/apps/web/package.json ./apps/web/package.json
COPY --from=builder --chown=pealuna:nodejs /app/apps/api/dist ./dist
COPY --from=builder --chown=pealuna:nodejs /app/infrastructure/docker/api-entrypoint.sh ./api-entrypoint.sh

# Entrypoint starts as root only to hand the mounted volume to pealuna,
# then drops to that user before running anything.
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
  CMD wget -qO- http://127.0.0.1:${PORT:-4000}/health/live || exit 1
CMD ["sh", "./api-entrypoint.sh"]
