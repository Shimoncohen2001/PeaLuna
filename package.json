{
  "name": "pealuna-platform",
  "version": "0.1.0",
  "private": true,
  "description": "PeaLuna — wig repair & care marketplace platform",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "db:generate": "pnpm --filter @velure/database db:generate",
    "db:migrate": "pnpm --filter @velure/database db:migrate",
    "db:migrate:dev": "pnpm --filter @velure/database db:migrate:dev",
    "db:seed": "pnpm --filter @velure/database exec prisma db seed",
    "db:studio": "pnpm --filter @velure/database db:studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@velure/config-eslint": "workspace:*",
    "@velure/config-typescript": "workspace:*",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
