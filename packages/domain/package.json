  "devDependencies": {
    "@velure/config-eslint": "workspace:*",
    "@velure/config-typescript": "workspace:*",
    "eslint": "^9.28.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
